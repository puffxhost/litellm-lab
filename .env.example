# Generate a unique local-only key, e.g. python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-change-this-local-key-before-starting
# Set this to the same value as LITELLM_MASTER_KEY for the benchmark CLI.
LITELLM_API_KEY=sk-change-this-local-key-before-starting
